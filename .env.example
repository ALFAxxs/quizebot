# POSTGRES_DB=quizbot
# POSTGRES_USER=quizbot
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwnFromBotFather
# Test tugagandan keyin qayta topshirishga ruxsat (True/False)
ALLOW_RETAKE=False
