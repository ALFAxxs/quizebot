# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Lokalda True, serverda False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Serverda domen bilan: https://test.example.uz
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Tashkent

# --- Database ---
# Quyidagi qatorlar izohda (#) qolsa — SQLite (db.sqlite3) ishlatiladi.
